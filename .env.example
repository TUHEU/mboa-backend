# development | production  (production refuses to start with a weak SECRET_KEY)
ENVIRONMENT=development
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-production-secret
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_ROUTES_API_KEY=your-server-restricted-routes-key
DATABASE_URL=sqlite:///./nyetam.db
# Exact origins allowed to call the API from a browser (Flutter web). In
# production put your real web domain here, e.g. ["https://app.example.com"]
CORS_ORIGINS=["http://localhost:8123","http://127.0.0.1:8123"]
